# API Keys
OPENAI_API_KEY=your-openai-api-key-here
STABLE_DIFFUSION_API_KEY=your-stable-diffusion-key-here
MIDJOURNEY_API_KEY=your-midjourney-key-here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_image_gen
DB_ECHO=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Training Configuration
TRAINING_DEVICE=cuda  # cuda or cpu
TRAINING_MAX_TIME=3600  # seconds
TRAINING_BATCH_SIZE=8
TRAINING_LEARNING_RATE=0.0001
TRAINING_EPOCHS=10
TRAINING_CHECKPOINT_INTERVAL=5

# Model Configuration
DEFAULT_MODEL=dall-e-3
DEFAULT_PROVIDER=openai
MODEL_CACHE_SIZE=5
MODEL_CACHE_PATH=./models/cache

# Storage Configuration
DATA_STORAGE_PATH=./data
DATASET_STORAGE_PATH=./data/datasets
SKILL_STORAGE_PATH=./data/skills
MODEL_STORAGE_PATH=./models
CACHE_STORAGE_PATH=./data/cache

# Feature Flags
ENABLE_AUTO_TRAINING=True
ENABLE_SKILL_UPLOADS=True
ENABLE_DATASET_UPLOADS=True
ENABLE_WEBHOOKS=True
ENABLE_ANALYTICS=True
ENABLE_CACHING=True

# Auto-Training Configuration
AUTO_TRAINING_INTERVAL=86400  # 24 hours in seconds
AUTO_TRAINING_MIN_FEEDBACK_COUNT=50
AUTO_TRAINING_ENABLED=True

# Analytics & Monitoring
WANDB_ENABLED=False
WANDB_PROJECT=ai-image-gen-wrapper
WANDB_ENTITY=your-entity

# Security
SECRET_KEY=your-secret-key-for-jwt-tokens
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_RATE_LIMIT=100  # requests per minute

# Webhook Configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT=30

# File Upload Configuration
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp
ALLOWED_DATA_FORMATS=json,csv,parquet
